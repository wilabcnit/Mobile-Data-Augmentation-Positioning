__pycache__/
*.pyc

# Radio KNN K = 2..5 models (re-created by train/radio/knn.py)
models/radio/knn_k*.pkl

# Exact GPR models store an N x N Cholesky factor (~500 MB each, above GitHub's file
# limit): re-create them with train/radio/gpr_rq.py and train/radio/gpr_se.py
models/radio/gpr_*.pkl

# Positioning models are regenerated by positioning/train.py all (several hundred MB)
models/positioning/*.pkl
